[app]

title = Kivy IDE
package.name = kivyide
package.domain = org.kivy

source.dir = .
source.exts = py,png,jpg,kv,atlas

version = 0.1

requirements = python3,kivy

orientation = portrait

android.permissions = WRITE_EXTERNAL_STORAGE,READ_EXTERNAL_STORAGE

[buildozer]
log_level = 2
warn_on_root = 1
