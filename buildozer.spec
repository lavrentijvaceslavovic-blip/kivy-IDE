[app]

# Название твоего приложения
title = Kivy IDE
package.name = kivyide
package.domain = org.kivy

# ВОТ ЭТУ СТРОЧКУ НУЖНО ДОБАВИТЬ:
version = 0.1

# Путь к исходному коду
source.dir = .
source.exts = py,png,jpg,kv,atlas

# Зависимости
requirements = python3,kivy

# Ориентация экрана
orientation = portrait
